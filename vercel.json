{
  "functions": {
    "api/transcribe.js": {
      "maxDuration": 300
    },
    "api/youtube.js": {
      "maxDuration": 300
    },
    "api/kb.js": {
      "maxDuration": 300
    },
    "api/v1/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://trader-knowlegdge.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://trader-knowlegdge.firebaseapp.com/__/firebase/:path*"
    }
  ]
}
